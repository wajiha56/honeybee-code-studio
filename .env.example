# ==========================================
# Frontend Variables (Vercel / Production UI)
# ==========================================
# Set this in your Vercel Project Settings -> Environment Variables
# If not set, it defaults automatically to https://honeybee-code-studio.onrender.com
VITE_BACKEND_URL=https://honeybee-code-studio.onrender.com

# ==========================================
# Backend Variables (Render.com Web Service)
# ==========================================
PORT=3000
NODE_ENV=production

# Gmail SMTP Configuration for Nodemailer
EMAIL_USER=honeybeecodestudio@gmail.com
# 16-character Google App Password (without spaces) generated from myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=your-16-char-app-password
COMPANY_EMAIL=honeybeecodestudio@gmail.com

# Gemini API Key (Optional / For AI Triage Assistant)
GEMINI_API_KEY=your-gemini-api-key

